// Cloudflare Pages configuration: the single source of truth for this
// project on Cloudflare. Everything except three secrets lives here.
//
// Secrets (Settings -> Variables and Secrets, type Secret, Production):
//   ADMIN_TOKEN        40+ random characters, for /admin/promoters
//   TURNSTILE_SECRET   the Turnstile widget's secret key
//   PLAUSIBLE_API_KEY  Plausible Stats API key
//
// The promoter leaderboard ships switched off (NEXT_PUBLIC_LEADERBOARD).
// To launch it: create the KV namespace and the Turnstile widget, add the
// secrets, then in one change uncomment kv_namespaces with the namespace id,
// set NEXT_PUBLIC_TURNSTILE_SITE_KEY, and set NEXT_PUBLIC_LEADERBOARD to "on".
//
// Pages has two environments: the production branch uses the top level,
// every other branch and pull request uses env.preview. Nothing is
// inherited. Previews get no bindings on purpose, so a preview can never
// touch production listings: they keep listing requests in memory, which is
// enough to click through the flow.
// Docs: https://developers.cloudflare.com/pages/functions/wrangler-configuration/
{
  "name": "palestine-pfp",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".vercel/output/static",

  // ---- production ----------------------------------------------------------
  "vars": {
    "NEXT_PUBLIC_LEADERBOARD": "off",
    // "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "<site key>",
  },
  // Listing requests, the approved list and the shared board cache.
  // "kv_namespaces": [{ "binding": "PROMOTERS", "id": "<namespace id>" }],

  // ---- preview: every non-production branch and pull request ---------------
  "env": {
    "preview": {
      "vars": {
        // No analytics from previews, so test traffic never reaches the
        // production Plausible site.
        "NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC": "off",
        // Links and robots.txt use the preview's own address (next.config.js).
        "PAGES_PREVIEW": "1",
      },
    },
  },
}
